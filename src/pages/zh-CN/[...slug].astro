---
import { getCollection, render } from 'astro:content'
import DocsLayout from '@/layouts/DocsLayout.astro'
import PlainLayout from '@/layouts/PlainLayout.astro'
import ApiReferenceLayout from '@/layouts/ApiReferenceLayout.astro'
import { resolveUrl, resolveLocale, resolveLayoutKind } from '@longbridge/openapi-utils'
import { currentRegion, includedInRegion } from '@longbridge/openapi-utils'
import { buildMdxComponents } from '@/mdx-components'
import { Pricing } from '@/components/mdx/Pricing'
import { NewHomePage } from '@longbridge/openapi-homepage'
import { SkillPage } from '@/components/mdx/SkillPage'

export async function getStaticPaths() {
  const region = currentRegion()
  const all = await getCollection('docs')
  return all
    .filter((e) => resolveLocale(e) === 'zh-CN')
    .filter((e) => includedInRegion(resolveUrl(e), region))
    .map((e) => {
      const url = resolveUrl(e)
      return {
        params: { slug: url === '/zh-CN' ? undefined : url.slice('/zh-CN/'.length) },
        props: { entry: e },
      }
    })
}

const { entry } = Astro.props
const { Content, headings } = await render(entry)
const titleStr =
  entry.data.title ??
  (entry.data as { titleTemplate?: string }).titleTemplate ??
  'Longbridge Developers'
const layoutKind = resolveLayoutKind(entry)
// docs/zh-CN/index.mdx — the homepage; hydrated island like Pricing (see en page).
const isHome = entry.id === 'zh-CN/index'
const isSkill = entry.id === 'zh-CN/skill/index'
---
{layoutKind === 'docs' && (
  <DocsLayout title={titleStr} locale="zh-CN" entry={entry} headings={headings}>
    <Content components={buildMdxComponents('zh-CN')} />
  </DocsLayout>
)}
{layoutKind === 'api' && (
  <ApiReferenceLayout title={titleStr} locale="zh-CN">
    <Content components={buildMdxComponents('zh-CN')} />
  </ApiReferenceLayout>
)}
{layoutKind === 'plain' && (
  <PlainLayout title={titleStr} locale="zh-CN">
    {entry.data.id === 'pricing' ? (
      <Pricing client:load locale="zh-CN" />
    ) : isHome ? (
      <NewHomePage client:load locale="zh-CN" />
    ) : isSkill ? (
      <SkillPage client:load locale="zh-CN" />
    ) : (
      <Content components={buildMdxComponents('zh-CN')} />
    )}
  </PlainLayout>
)}

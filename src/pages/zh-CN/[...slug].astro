---
import { getCollection, render } from 'astro:content'
import DocsLayout from '@/layouts/DocsLayout.astro'
import PlainLayout from '@/layouts/PlainLayout.astro'
import ApiReferenceLayout from '@/layouts/ApiReferenceLayout.astro'
import { resolveUrl, resolveLocale } from '@lib/slug'
import { currentRegion, includedInRegion } from '@lib/region'
import { mdxComponents } from '@/mdx-components'

export async function getStaticPaths() {
  const region = currentRegion()
  const all = await getCollection('docs')
  return all
    .filter((e) => resolveLocale(e) === 'zh-CN')
    .filter((e) => includedInRegion(resolveUrl(e), region))
    .map((e) => {
      const url = resolveUrl(e)
      return {
        params: { slug: url === '/zh-CN' ? undefined : url.slice('/zh-CN/'.length) },
        props: { entry: e },
      }
    })
}

const { entry } = Astro.props
const { Content, headings } = await render(entry)
const titleStr = entry.data.title ?? '(untitled)'
const layoutKind =
  entry.data.docs_layout === 'api-reference' ? 'api'
  : entry.data.docs_layout === false ? 'plain'
  : 'docs'
---
{layoutKind === 'docs' && (
  <DocsLayout title={titleStr} locale="zh-CN" entry={entry} headings={headings}>
    <Content components={mdxComponents} />
  </DocsLayout>
)}
{layoutKind === 'api' && (
  <ApiReferenceLayout title={titleStr} locale="zh-CN">
    <Content components={mdxComponents} />
  </ApiReferenceLayout>
)}
{layoutKind === 'plain' && (
  <PlainLayout title={titleStr} locale="zh-CN">
    <Content components={mdxComponents} />
  </PlainLayout>
)}

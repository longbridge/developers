---
import { getCollection, render } from 'astro:content'
import DocsLayout from '@/layouts/DocsLayout.astro'
import PlainLayout from '@/layouts/PlainLayout.astro'
import ApiReferenceLayout from '@/layouts/ApiReferenceLayout.astro'
import { resolveUrl, resolveLocale, resolveLayoutKind } from '@longbridge/openapi-utils'
import { currentRegion, includedInRegion } from '@longbridge/openapi-utils'
import { buildMdxComponents } from '@/mdx-components'

export async function getStaticPaths() {
  const region = currentRegion()
  const all = await getCollection('docs')
  return all
    .filter((e) => resolveLocale(e) === 'en')
    .filter((e) => includedInRegion(resolveUrl(e), region))
    .map((e) => {
      const url = resolveUrl(e)
      return {
        params: { slug: url === '/' ? undefined : url.replace(/^\//, '') },
        props: { entry: e },
      }
    })
}

const { entry } = Astro.props
const { Content, headings } = await render(entry)
// Fallback: index / marketing pages (sdk, pricing, skill) may ship no
// `title` frontmatter — use `titleTemplate` if present, otherwise the
// site brand. Legacy vitepress used the same order.
const titleStr =
  entry.data.title ??
  (entry.data as { titleTemplate?: string }).titleTemplate ??
  'Longbridge Developers'
const layoutKind = resolveLayoutKind(entry)
---
{layoutKind === 'docs' && (
  <DocsLayout title={titleStr} locale="en" entry={entry} headings={headings}>
    <Content components={buildMdxComponents('en')} />
  </DocsLayout>
)}
{layoutKind === 'api' && (
  <ApiReferenceLayout title={titleStr} locale="en">
    <Content components={buildMdxComponents('en')} />
  </ApiReferenceLayout>
)}
{layoutKind === 'plain' && (
  <PlainLayout title={titleStr} locale="en">
    <Content components={buildMdxComponents('en')} />
  </PlainLayout>
)}

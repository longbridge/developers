---
import '@styles/global.css'
import { ClientRouter } from 'astro:transitions'
import SkipLink from '../components/shell/SkipLink.astro'
import TopNav from '../components/shell/TopNav'
import Footer from '../components/shell/Footer'
import type { Locale } from '@longbridge/openapi-utils'

export interface Props {
  title: string
  description?: string
  locale?: Locale
  /** Suppress the big 4-column marketing footer. Docs pages set this — legacy
   *  docs render only a slim link-row footer (DocFooter) inside the article,
   *  never the marketing footer. */
  hideFooter?: boolean
}
const { title, description = '', locale = 'en', hideFooter = false } = Astro.props
const pathname = new URL(Astro.request.url).pathname
---
<!doctype html>
<html lang={locale} data-mode="light" data-theme="default" data-nb-pref="system">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <ClientRouter />
    <script is:inline>
      // Applies the persisted theme to <html>. Runs synchronously on first
      // load (no flash) AND on every ClientRouter swap — the swap replaces
      // <html>'s attributes with the new document's SSR defaults (data-mode
      // "light"), so without re-applying here a dark-mode user flashes light
      // on each navigation. The listener is registered once on <document>
      // (which survives swaps), so it is not duplicated per navigation.
      ;(function () {
        function applyTheme() {
          var pref = localStorage.getItem('ui-mode') || 'system'
          var dark =
            pref === 'dark' ||
            (pref === 'system' && matchMedia('(prefers-color-scheme: dark)').matches)
          var root = document.documentElement
          root.dataset.mode = dark ? 'dark' : 'light'
          root.dataset.nbPref = pref
        }
        applyTheme()
        document.addEventListener('astro:after-swap', applyTheme)
      })()
    </script>
  </head>
  <body>
    <SkipLink />
    {/* Locale-scoped persist name: the shell stays mounted (no re-hydrate
        flicker, theme-toggle keeps state) while navigating within a locale,
        but re-mounts when the locale changes so labels/links update. TopNav
        re-syncs its active highlight from location.pathname on each swap. */}
    <TopNav locale={locale} pathname={pathname} client:load transition:persist={`nav-${locale}`} />
    <main id="main-content" data-lbus-page={pathname}>
      <slot />
    </main>
    {!hideFooter && <Footer locale={locale} client:idle transition:persist={`footer-${locale}`} />}
    {/* tabs-hydrate: vanilla-JS progressive enhancement for <Tabs>/<TabItem>.
        Astro renders MDX React components in isolated React roots, so
        React.Children and React context don't propagate across the serialisation
        boundary. TabItem !ctx branch emits data-tab-* attrs; this script reads
        them to build the interactive tab bar and manage visibility. */}
    <script>import '../scripts/tabs-hydrate'</script>
  </body>
</html>

---
import '@styles/global.css'
import SkipLink from '../components/shell/SkipLink.astro'
import TopNav from '../components/shell/TopNav'
import Footer from '../components/shell/Footer'
import type { Locale } from '@longbridge/openapi-utils'

export interface Props {
  title: string
  description?: string
  locale?: Locale
}
const { title, description = '', locale = 'en' } = Astro.props
const pathname = new URL(Astro.request.url).pathname
---
<!doctype html>
<html lang={locale} data-mode="light" data-theme="default" data-nb-pref="system">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <script is:inline>
      const pref = localStorage.getItem('ui-mode') ?? 'system'
      const dark = pref === 'dark' || (pref === 'system' && matchMedia('(prefers-color-scheme: dark)').matches)
      const root = document.documentElement
      root.dataset.mode = dark ? 'dark' : 'light'
      root.dataset.nbPref = pref
    </script>
  </head>
  <body>
    <SkipLink />
    <TopNav locale={locale} pathname={pathname} client:load />
    <main id="main-content" data-lbus-page={pathname}>
      <slot />
    </main>
    <Footer locale={locale} client:idle />
    {/* tabs-hydrate: vanilla-JS progressive enhancement for <Tabs>/<TabItem>.
        Astro renders MDX React components in isolated React roots, so
        React.Children and React context don't propagate across the serialisation
        boundary. TabItem !ctx branch emits data-tab-* attrs; this script reads
        them to build the interactive tab bar and manage visibility. */}
    <script>import '../scripts/tabs-hydrate'</script>
  </body>
</html>

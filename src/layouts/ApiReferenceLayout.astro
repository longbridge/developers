---
import BaseLayout from './BaseLayout.astro'
import type { Locale } from '@longbridge/openapi-utils'
import { ApiReference } from '@longbridge/openapi-api-reference'
import '@longbridge/openapi-api-reference/src/api-reference.css'

export interface Props {
  title: string
  description?: string
  locale?: Locale
  initialId?: string
}

const { title, description = '', locale = 'en', initialId } = Astro.props
---
<BaseLayout title={title} description={description} locale={locale} hideFooter>
  <ApiReference client:load locale={locale} initialId={initialId} />
</BaseLayout>

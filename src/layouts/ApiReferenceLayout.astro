---
import BaseLayout from './BaseLayout.astro'
import type { Locale } from '@longbridge/openapi-utils'
import { ApiReference } from '@longbridge/openapi-api-reference'
import '@longbridge/openapi-api-reference/src/api-reference.css'

// Import the raw YAML spec (processed by Vite's ?raw loader)
import rawYaml from '../../openapi.yaml?raw'

export interface Props {
  title: string
  description?: string
  locale?: Locale
}

const { title, description = '', locale = 'en' } = Astro.props
---
<BaseLayout title={title} description={description} locale={locale}>
  <ApiReference client:load rawYaml={rawYaml} locale={locale} />
</BaseLayout>

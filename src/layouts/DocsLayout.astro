---
import BaseLayout from './BaseLayout.astro'
import type { CollectionEntry } from 'astro:content'
import type { Locale } from '@longbridge/openapi-utils'
import Breadcrumb from '@components/shell/Breadcrumb'
import type { BreadcrumbItem } from '@components/shell/Breadcrumb'
import LocalNav from '@components/shell/LocalNav'
import Sidebar from '@components/shell/Sidebar'
import TOC from '@components/shell/TOC'
import type { TocHeading } from '@components/shell/TOC'
import PrevNext from '@components/shell/PrevNext'
import { buildSidebar, getPrevNext, resolveSidebarScope, findBreadcrumbTrail } from '@longbridge/openapi-utils'

interface Props {
  title: string
  locale: Locale
  entry: CollectionEntry<'docs'>
  headings: TocHeading[]
}

const { title, locale, entry, headings } = Astro.props
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/'
const sidebar = buildSidebar(locale, resolveSidebarScope(pathname))
const { prev, next } = getPrevNext(sidebar, pathname)

// Build multi-layer breadcrumb by walking the sidebar tree; fall back
// to just the current page title if the pathname isn't in the sidebar.
const trail = findBreadcrumbTrail(sidebar, pathname)
const crumbs: BreadcrumbItem[] =
  trail.length > 0
    ? trail.map((t, i) => ({
        text: t.text,
        // Last crumb is the current page — no href.
        href: i < trail.length - 1 ? t.href : undefined,
      }))
    : [{ text: entry.data.title ?? '(untitled)' }]
---

<BaseLayout title={title} locale={locale}>
  <LocalNav locale={locale} pathname={pathname} nodes={sidebar} client:load />
  <div class="docs-layout">
    <Sidebar nodes={sidebar} pathname={pathname} client:load />
    <div class="docs-body">
      <div class="docs-inner">
        <article class="docs-content">
          {!entry.data.hide_breadcrumb && (
            <Breadcrumb locale={locale} items={crumbs} />
          )}
          <slot />
          <PrevNext prev={prev} next={next} />
        </article>
        <TOC headings={headings} locale={locale} client:load />
      </div>
    </div>
  </div>
</BaseLayout>
